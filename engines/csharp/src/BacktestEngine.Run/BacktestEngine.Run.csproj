<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../BacktestEngine.CAlgoShim/BacktestEngine.CAlgoShim.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(StrategySource)' == ''">
    <Compile Include="../../examples/ExampleStrategy.cs" Link="Strategies/ExampleStrategy.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(StrategySource)' != ''">
    <!-- Source-linked builds import this project from a generated wrapper; the wrapper's own
         directory has no compile items, so the runner sources are linked explicitly. -->
    <Compile Include="$(MSBuildThisFileDirectory)*.cs" />
    <Compile Include="$(StrategySource)" Link="Strategies/SelectedStrategy.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(StrategyHelperSources)' != ''">
    <!-- Explicit same-project helper files, copied into the immutable build by the engine service. -->
    <Compile Include="$(StrategyHelperSources)" Link="Strategies/Helpers/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
