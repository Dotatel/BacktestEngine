{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValidationEngine Config",
  "type": "object",
  "required": ["RunName", "ParameterFile", "OutputRoot", "Backtest", "Symbols", "Windows", "CostStress", "MonteCarlo", "WalkForward", "Gates"],
  "properties": {
    "RunName": { "type": "string" },
    "Strategy": { "type": "string" },
    "ParameterFile": { "type": "string" },
    "ParameterOverrides": { "type": "object" },
    "OutputRoot": { "type": "string" },
    "RunBacktests": { "type": "boolean" },
    "Backtest": { "type": "object" },
    "Symbols": { "type": "array" },
    "Windows": { "type": "array" },
    "CostStress": { "type": "object" },
    "LatencyStress": { "type": "object" },
    "MonteCarlo": { "type": "object" },
    "WalkForward": { "type": "object" },
    "Gates": { "type": "object" },
    "ExistingReports": { "type": "array" }
  }
}
