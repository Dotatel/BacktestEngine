{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DotaTel BacktestEngine",
  "version": "0.1.0",
  "identifier": "tel.dotatel.backtest.standalone",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DotaTel BacktestEngine",
        "width": 660,
        "height": 470,
        "minWidth": 600,
        "minHeight": 440,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": false,
        "backgroundColor": "#080D0A"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "resources/engine/": "engine/",
      "resources/enginesrc/": "enginesrc/",
      "resources/validation/": "validation/",
      "resources/optimizer/": "optimizer/",
      "resources/runtimes/": "runtimes/"
    },
    "windows": {
      "nsis": { "installerHooks": "windows/installer-hooks.nsh" },
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true }
    }
  }
}
